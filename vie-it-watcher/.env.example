# Copie ce fichier en ".env" pour tester en local (npm start).
# En production (GitHub Actions), ces valeurs vont dans
# Settings > Secrets and variables > Actions, pas dans un fichier.

# --- Resend (envoi d'email) ---
# Crée un compte gratuit sur https://resend.com, récupère une clé API.
RESEND_API_KEY=re_xxxxxxxxxxxx
DIGEST_TO_EMAIL=ton.email@example.com
# Doit rester "onboarding@resend.dev" tant que tu n'as pas vérifié ton propre domaine sur Resend.
DIGEST_FROM_EMAIL=VIE Watcher <onboarding@resend.dev>

# --- France Travail (offres IT/VIE complémentaires) ---
# Crée un compte sur https://francetravail.io, une application,
# active l'API "Offres d'emploi v2".
FT_CLIENT_ID=xxxxxxxxxxxx
FT_CLIENT_SECRET=xxxxxxxxxxxx

# --- Debug ---
# Mets à 1 pour sauvegarder les réponses réseau capturées sur le site VIE
# (utile si le scraper ne trouve aucune offre, pour qu'on ajuste ensemble).
DEBUG_VIE=0
